{
  "name": "@rhythmjs/observability",
  "version": "0.0.6",
  "description": "Observability middleware (logging, request ids, server timing, health checks, graceful shutdown) for Rhythm routers and handlers.",
  "keywords": [
    "graceful-shutdown",
    "health-check",
    "liveness",
    "logging",
    "middleware",
    "observability",
    "readiness",
    "request-id",
    "rhythm",
    "server-timing"
  ],
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhythmjs/observability.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./health": {
      "types": "./dist/health/health.d.ts",
      "default": "./dist/health/health.js"
    },
    "./log": {
      "types": "./dist/log/log.d.ts",
      "default": "./dist/log/log.js"
    },
    "./request-id": {
      "types": "./dist/request-id/request-id.d.ts",
      "default": "./dist/request-id/request-id.js"
    },
    "./timing": {
      "types": "./dist/timing/timing.d.ts",
      "default": "./dist/timing/timing.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/health/health.ts src/log/log.ts src/request-id/request-id.ts src/timing/timing.ts --outdir dist --root src --format esm --target bun --packages external --splitting && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run check && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src",
    "fmt": "prettier --write \"src/**/*.ts\" \"*.json\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"*.json\"",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^26.6.3",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@rhythmjs/rhythm": ">=0.0.14",
    "@rhythmjs/router": ">=0.0.13"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
